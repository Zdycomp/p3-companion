# Copy to suprevolt.env (Docker) or /etc/suprevolt.env (systemd), then: chmod 600
# One AI key is enough. Without any key the AI scans answer UNKNOWN and say why.
SUPREVOLT_GEMINI_KEY=
SUPREVOLT_ANTHROPIC_KEY=
# Optional
# SUPREVOLT_AI_PROVIDER=gemini          # or claude; default: whichever key is set (Claude first)
# SUPREVOLT_GEMINI_MODEL=gemini-2.5-flash
# SUPREVOLT_CLAUDE_MODEL=claude-sonnet-5-5
# SUPREVOLT_ENABLE_EVER_RUN=1           # let ever.run execute .ever programs (sandboxed)
# SUPREVOLT_TOKEN_HASH=                 # only for hosts that wipe their disk (Render)
