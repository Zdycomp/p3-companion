<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluetooth Classic link to the glasses -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Finding new glasses nearby: scan on Android 12+, location on Android 11 (the app never uses location) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- 3.8: also the Wi-Fi screen, because Android shows Wi-Fi names and the network list only to apps with
         location. Asked only when that screen opens; the app never reads the location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Live view test (3.3) and the Wi-Fi screen (3.8): look for the glasses on Wi-Fi; asked only when used -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- 3.8 Wi-Fi screen: join the glasses' network for this app only (Android confirms), read the phone's network state -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Assistant: talks to the AI service you choose -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice questions, translation, Conversation translate, the voice recorder and (when chosen) sound for live view
         recordings, through the glasses' headset link when connected -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Keeps a voice recording going with the screen off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Keeps the glasses connected in the background so button photos are still saved -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- 4.0: keeps the phone's flashlight on with the app in the background (Android turns the torch off
         when the app that turned it on goes away), with a "Flashlight on · Turn off" notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Two short pulses when a photo from the glasses is saved (Settings › Capture) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Lock the app with fingerprint, face or the screen lock (Settings › Privacy) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- "Set a timer" and "set an alarm" voice commands hand the time to the phone's clock app -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- Lets the app find the phone's speech recognizer and text-to-speech engine on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- 4.0: Google's speech engine, used for the phone's voice instead of the phone default -->
        <package android:name="com.google.android.tts" />
        <!-- The system speech dialog, used when no recognition service answers -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Home-screen shortcuts: Take photo, Live view, Voice chat -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- Lets the bug report notification share straight into the app for key setup -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.android.bugreport" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <service
            android:name=".GlassesService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Brings the link back when the glasses reconnect to the phone after the app was closed.
             ACL_CONNECTED is a protected system broadcast that needs BLUETOOTH_CONNECT. -->
        <receiver
            android:name=".GlassesWakeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings tile: one tap takes a photo while the glasses are connected -->
        <service
            android:name=".PhotoTileService"
            android:exported="true"
            android:icon="@drawable/ic_photo_camera"
            android:label="@string/tile_photo"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- 4.0: Quick Settings tile: the phone's flashlight on or off -->
        <service
            android:name=".FlashlightTileService"
            android:exported="true"
            android:icon="@drawable/ic_flashlight"
            android:label="@string/tile_flashlight"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- 4.0: keeps the flashlight on until it's turned off, with Turn off in its notification -->
        <service
            android:name=".TorchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the phone's flashlight on, as the user asked, until they turn it off from the notification, the app or Quick Settings." />
        </service>

        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 3.6: Conversation translate keeps listening with the screen closed (only when that setting is on) -->
        <service
            android:name=".ConversationService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 3.7: shares the voice clips from Test voice ("Play back what the glasses heard"), read-only -->
        <provider
            android:name=".ClipProvider"
            android:authorities="${applicationId}.clips"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
