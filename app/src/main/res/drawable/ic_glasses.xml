<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher foreground: glasses with violet-to-ocean lenses, kept inside the 66 dp safe circle (27-81). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- left lens -->
    <path
        android:pathData="M30,47L51,47L49.5,60Q48.5,66 42.5,66L37,66Q31,66 30.5,60Z"
        android:strokeColor="#FFF4F1FA"
        android:strokeWidth="2.5"
        android:strokeLineJoin="round">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="47"
                android:endX="51"
                android:endY="66"
                android:startColor="#FF8B5CF6"
                android:endColor="#FF0EA5E9" />
        </aapt:attr>
    </path>
    <!-- right lens -->
    <path
        android:pathData="M57,47L78,47L77.5,60Q77,66 71,66L65.5,66Q59.5,66 58.5,60Z"
        android:strokeColor="#FFF4F1FA"
        android:strokeWidth="2.5"
        android:strokeLineJoin="round">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="57"
                android:startY="47"
                android:endX="78"
                android:endY="66"
                android:startColor="#FF8B5CF6"
                android:endColor="#FF0EA5E9" />
        </aapt:attr>
    </path>
    <!-- frame bar and bridge -->
    <path
        android:fillColor="#FFF4F1FA"
        android:pathData="M29,43.5h50a2,2 0,0 1,2 2v1.5a2,2 0,0 1,-2 2h-50a2,2 0,0 1,-2 -2v-1.5a2,2 0,0 1,2 -2z" />
    <!-- specular highlights -->
    <path
        android:pathData="M34,51.5Q34,56 36,59 M61,51.5Q61,56 63,59"
        android:strokeColor="#59FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- camera dot with a white ring -->
    <path
        android:fillColor="#FF34D399"
        android:strokeColor="#FFF4F1FA"
        android:strokeWidth="1.5"
        android:pathData="M31,39m-3,0a3,3 0,1 0,6 0a3,3 0,1 0,-6 0" />
</vector>
